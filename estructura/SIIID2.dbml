Table carga {
  id_carga bigint [pk, not null, increment]
  id_usuario_carga int [not null, ref: > usuario.id_usuario]
  codigo_referencia varchar(50) [not null]
  mes_corte tinyint [not null]
  anio_corte smallint [not null]
  fecha_carga datetime [not null, default: `SYSDATETIME()`]
  total_carpetas_investigacion int [not null]
  total_delitos int [not null]
  total_victimas int [not null]
  estado varchar(30) [not null, default: 'VALIDADO_PENDIENTE']
  fecha_validacion datetime [not null, default: `SYSDATETIME()`]
  fecha_confirmacion datetime
  fecha_expiracion datetime
  id_usuario_confirmacion int [ref: > usuario.id_usuario]
  mensaje_error text
  activo boolean [not null, default: 1]

  indexes {
    (codigo_referencia) [unique, name: 'uk_carga_codigo_referencia']
    (id_usuario_carga) [name: 'idx_carga_usuario_carga']
    (id_usuario_confirmacion) [name: 'idx_carga_usuario_confirmacion']
    (codigo_referencia) [name: 'idx_carga_codigo_referencia']
    (estado) [name: 'idx_carga_estado']
  }
}

